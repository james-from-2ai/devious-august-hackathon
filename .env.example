# Copy to .env and fill in. .env is gitignored and must stay that way.

ANTHROPIC_API_KEY=sk-ant-...

# Your team name and token, handed out at the start of the session.
TEAM_NAME=pair-a
TEAM_TOKEN=

# Both of your names, comma separated. These appear on the leaderboard, so
# put what you want the room to see.
PARTICIPANTS=Ada Lovelace, Grace Hopper

# The scorer. Set at the start of Block 1.
SCORER_URL=https://scorer.example.workers.dev

# Your public tunnel URL, printed by `make tunnel`. Changes every time
# cloudflared restarts, so re-run `make register` when it does.
ENDPOINT_URL=

# 1 for text in / text out, 2 for audio.
BLOCK=1

ADVISE_MODEL=claude-sonnet-4-6
