# Copy to .env and fill in. .env is gitignored and must stay that way.

ANTHROPIC_API_KEY=sk-ant-...

# Your team name. It is also your identity with the judge, so pick it once
# and keep it: changing names mid-event starts a fresh leaderboard row.
TEAM_NAME=pair-a

# Leave empty. Only used if the event runs in strict-token mode.
TEAM_TOKEN=

# Both of your names, comma separated. These appear on the leaderboard, so
# put what you want the room to see.
PARTICIPANTS=Ada Lovelace, Grace Hopper

# The scorer. Set at the start of Block 1.
SCORER_URL=https://scorer.example.workers.dev

# Your public tunnel URL, printed by `make tunnel`. Changes every time
# cloudflared restarts, so re-run `make register` when it does.
ENDPOINT_URL=

# Leave as 1. What changes in block 2 is announced at 12:30.
BLOCK=1

ADVISE_MODEL=claude-sonnet-4-6
